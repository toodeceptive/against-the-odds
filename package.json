{
  "name": "against-the-odds",
  "version": "1.0.0",
  "description": "Official Against The Odds (AO) brand website and store",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --config=playwright.config.js",
    "test:e2e:smoke": "playwright test --config=playwright.config.js --project=chromium",
    "test:e2e:live": "playwright test --config=playwright.live.config.js",
    "check:desktop:env": "node scripts/shared/run-powershell.cjs scripts/desktop-automation/test-system.ps1",
    "test:shopify": "playwright test --config=playwright.shopify.config.js",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm test && npm run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,jsx,tsx,json,css,md,html,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,jsx,tsx,json,css,md,html,yml,yaml}\"",
    "quality": "npm run format:check && npm run lint && npm run test:unit",
    "quality:fix": "npm run format && npm run lint:fix && npm run quality",
    "build": "echo 'Build process not yet configured'",
    "dev": "echo 'Development server not yet configured'",
    "setup": "node scripts/shared/run-powershell.cjs scripts/setup-env.ps1",
    "setup:auto": "node scripts/shared/run-powershell.cjs scripts/setup/auto-configure-env.ps1",
    "health": "node scripts/shared/run-powershell.cjs scripts/health/comprehensive-check.ps1",
    "sync": "node scripts/shared/run-powershell.cjs scripts/sync/sync-all.ps1",
    "verify:governance": "node scripts/github/verify-governance-settings.js",
    "test:desktop": "npm run check:desktop:env",
    "test:desktop:quick": "node scripts/shared/run-powershell.cjs scripts/desktop-automation/test-system.ps1 -Quick",
    "test:desktop:vitest": "vitest run tests/desktop-automation",
    "verify:pipeline": "node scripts/shared/run-powershell.cjs scripts/verify-pipeline.ps1",
    "verify:pipeline:strict": "node scripts/shared/run-powershell.cjs scripts/verify-pipeline.ps1 -RequireRunbook",
    "verify:theme-branch": "node scripts/shopify/verify-theme-branch.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "e-commerce",
    "shopify",
    "brand",
    "merchandise"
  ],
  "author": "Against The Odds",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.40.0",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.26.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.1.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.0",
    "tesseract.js": "^5.0.4"
  },
  "optionalDependencies": {
    "node-window-manager": "^2.2.4",
    "robotjs": "^0.6.0"
  },
  "overrides": {
    "minimatch": "3.1.5"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,jsx,tsx,json,css,md,html,yml,yaml}": "prettier --write"
  }
}
